{
  "name": "whenpc",
  "version": "0.2.1",
  "description": "Windows desktop widget for CPU / memory / GPU / disk / network / temperature usage",
  "author": "when630",
  "repository": "github:when630/whenpc",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.when630.whenpc",
    "productName": "whenpc",
    "files": [
      "src/**",
      "collector/**",
      "package.json",
      "!node_modules/pretendard/{docs,subset.js,subset_glyphs.txt}",
      "!node_modules/pretendard/docs/**",
      "!node_modules/pretendard/dist/public/**",
      "!node_modules/pretendard/dist/web/static/**",
      "!node_modules/pretendard/dist/web/variable/woff2/**",
      "!node_modules/@fontsource/*/files/*.woff",
      "!node_modules/@fontsource/*/files/*-italic.woff2",
      "!node_modules/@fontsource/noto-serif-kr/files/*-{100,200,300,500,600,700,800,900}-normal.woff2",
      "!node_modules/@fontsource/archivo/files/*-{100,200,300,400,500,600,700,800}-normal.woff2",
      "!node_modules/@fontsource/geist-mono/files/*-{100,200,300,600,700,800,900}-normal.woff2",
      "!node_modules/@fontsource/gaegu/files/*-300-normal.woff2"
    ],
    "asarUnpack": [
      "collector/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "whenpc-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "when630",
      "repo": "whenpc",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "electron-updater": "^6.8.11",
    "pretendard": "^1.3.9"
  }
}
