{
  "name": "whenpc",
  "version": "0.1.0",
  "description": "Windows desktop widget for CPU / memory / GPU / disk / network / temperature usage",
  "author": "when630",
  "repository": "github:when630/whenpc",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.when630.whenpc",
    "productName": "whenpc",
    "files": [
      "src/**",
      "collector/**",
      "package.json"
    ],
    "asarUnpack": [
      "collector/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "whenpc-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "when630",
      "repo": "whenpc",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
